rules_version = '2';
// חוקי האבטחה של לוח המשימות.
// לפני ההדבקה ב-Firebase: החליפו את ADMIN_EMAIL במייל של המנהל.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ADMIN_EMAIL'];
    }

    function taskDoc(id) { return get(/databases/$(database)/documents/tasks/$(id)); }
    function memberExists(id) { return exists(/databases/$(database)/documents/members/$(id)); }
    function freshTime(d) { return d.at is int && math.abs(d.at - request.time.toMillis()) < 600000; }

    // המכשיר הזה נכנס בתור בן המשפחה m עם הקוד הנכון שלו. שינוי קוד מנתק את כל המכשירים שנכנסו עם הקוד הישן.
    function boundTo(m) {
      let bPath = /databases/$(database)/documents/bindings/$(request.auth.uid);
      let pPath = /databases/$(database)/documents/pins/$(m);
      return signedIn() && exists(bPath) && exists(pPath)
        && get(bPath).data.memberId == m
        && get(bPath).data.pin == get(pPath).data.pin;
    }

    function validFixed(d) {
      return d.keys().hasOnly(['kind','taskId','title','memberId','points','day','at'])
        && d.kind == 'task'
        && exists(/databases/$(database)/documents/tasks/$(d.taskId))
        && taskDoc(d.taskId).data.get('timed', false) == false
        && taskDoc(d.taskId).data.get('pending', false) == false
        && memberExists(d.memberId)
        && d.points == taskDoc(d.taskId).data.points
        && freshTime(d);
    }

    function validTimed(d) {
      let timerPath = /databases/$(database)/documents/timers/$(d.timerId);
      let timer = get(timerPath).data;
      let task = taskDoc(d.taskId).data;
      return d.keys().hasOnly(['kind','taskId','title','memberId','points','minutes','timerId','day','at'])
        && d.kind == 'timed'
        && d.timerId == d.taskId + '__' + d.memberId
        && timer.taskId == d.taskId
        && timer.memberId == d.memberId
        && task.get('timed', false) == true
        && d.minutes is int && d.minutes >= 1 && d.minutes <= task.maxMinutes
        && d.minutes * 60000 <= request.time.toMillis() - timer.startedAt.toMillis() + 60000
        && d.points == d.minutes * task.ratePerMin
        && !existsAfter(timerPath)
        && freshTime(d);
    }

    function validNewTask(d) {
      return d.keys().hasOnly(['title','assignee','type','days','timed','points','ratePerMin','maxMinutes','reviewed','suggestedBy','createdAt'])
        && d.reviewed == false
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.assignee is string
        && d.type in ['once', 'repeat']
        && d.days is list && d.days.size() <= 7
        && d.createdAt is int
        && d.suggestedBy is string && boundTo(d.suggestedBy)
        && ((d.timed == true && d.ratePerMin is int && d.ratePerMin >= 1 && d.ratePerMin <= 100
              && d.maxMinutes is int && d.maxMinutes >= 1 && d.maxMinutes <= 240)
         || (d.timed == false && d.points is int && d.points >= 0 && d.points <= 1000));
    }

    // קודי כניסה: רק המנהל רואה ומשנה.
    match /pins/{memberId} {
      allow read, write: if isAdmin();
    }

    // כניסה של מכשיר בתור בן משפחה: מותרת רק עם הקוד הנכון.
    match /bindings/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberId','pin'])
        && request.resource.data.memberId is string
        && exists(/databases/$(database)/documents/pins/$(request.resource.data.memberId))
        && request.resource.data.pin == get(/databases/$(database)/documents/pins/$(request.resource.data.memberId)).data.pin;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // פרופיל: כולם רואים; כל אחד משנה רק את התמונה של עצמו (המנהל של כולם).
    match /profiles/{memberId} {
      allow read: if signedIn();
      allow write: if (isAdmin() || boundTo(memberId))
        && request.resource.data.keys().hasOnly(['avatar'])
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16;
    }

    // מכשירים שמקבלים התראות. רק השרת (וגם המנהל) קורא אותם.
    match /pushTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['memberId','uid','at'])
        && request.resource.data.uid == request.auth.uid
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /members/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && validNewTask(request.resource.data));
      allow update: if isAdmin();
      // משימה נעוצה: אף אחד, גם לא המנהל, לא יכול למחוק אותה עד שמבטלים נעיצה.
      allow delete: if isAdmin() && resource.data.get('pinned', false) == false;
    }
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId','memberId','text','at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time
        && request.resource.data.taskId is string
        && (request.resource.data.taskId == 'general'
            || exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)))
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /timers/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId','memberId','startedAt'])
        && id == request.resource.data.taskId + '__' + request.resource.data.memberId
        && request.resource.data.startedAt == request.time
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
        && taskDoc(request.resource.data.taskId).data.get('timed', false) == true
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if isAdmin() || boundTo(resource.data.memberId);
    }
    match /logs/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (request.resource.data.kind == 'task' && validFixed(request.resource.data) && boundTo(request.resource.data.memberId))
        || (request.resource.data.kind == 'timed' && validTimed(request.resource.data) && boundTo(request.resource.data.memberId));
      allow delete: if isAdmin() || (
        resource.data.kind in ['task', 'timed']
        && request.time.toMillis() - resource.data.at < 43200000
        && boundTo(resource.data.memberId)
      );
      allow update: if isAdmin();
    }
  }
}
