rules_version = '2';
// חוקי האבטחה של לוח המשימות.
// לפני ההדבקה ב-Firebase: החליפו את ADMIN_EMAIL במייל של המנהל.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // מנהל = מי שנכנס עם גוגל עם המייל של המנהל, או מכשיר שנכנס עם קוד המנהל הנוכחי.
    function isAdmin() {
      return (signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['ADMIN_EMAIL'])
        || adminByCode();
    }
    function adminByCode() {
      let sPath = /databases/$(database)/documents/adminSessions/$(request.auth.uid);
      let cPath = /databases/$(database)/documents/private/admin;
      return signedIn() && exists(sPath) && exists(cPath)
        && get(sPath).data.code == get(cPath).data.code;
    }

    function taskDoc(id) { return get(/databases/$(database)/documents/tasks/$(id)); }
    function memberExists(id) { return exists(/databases/$(database)/documents/members/$(id)); }
    function freshTime(d) { return d.at is int && math.abs(d.at - request.time.toMillis()) < 600000; }

    // המכשיר הזה נכנס בתור בן המשפחה m עם הקוד הנכון שלו. שינוי קוד מנתק את כל המכשירים שנכנסו עם הקוד הישן.
    // המכשיר הזה פועל בשם בן המשפחה m: נכנס עם הקוד הנכון שלו, או מחובר עם חשבון הגוגל שמקושר אליו.
    function boundTo(m) {
      let bPath = /databases/$(database)/documents/bindings/$(request.auth.uid);
      let pPath = /databases/$(database)/documents/pins/$(m);
      let mPath = /databases/$(database)/documents/members/$(m);
      return signedIn() && (
        (exists(bPath) && exists(pPath)
          && get(bPath).data.memberId == m
          && get(bPath).data.pin == get(pPath).data.pin)
        || (exists(mPath) && get(mPath).data.get('uid', '') == request.auth.uid));
    }

    // משימה שמסומנת "צריך אישור": הרישום חייב להתחיל כלא מאושר. אחרת אסור לשלוח שדה אישור.
    function validUntil(d) { return !('untilTime' in d) || (d.untilTime is string && d.untilTime.size() == 5); }
    function validQty(d) {
      return (!('qtyPer' in d) && !('qtyUnit' in d) && !('qtyMax' in d))
        || (d.timed == false && d.qtyPer is int && d.qtyPer >= 1 && d.qtyPer <= 1000
            && (!('qtyMax' in d) || (d.qtyMax is int && d.qtyMax >= d.qtyPer && d.qtyMax <= 10000))
            && d.qtyUnit is string && d.qtyUnit.size() > 0 && d.qtyUnit.size() <= 20);
    }

    // a parent acting for someone else: by default only children; the admin can set exactly who (canMarkFor)
    function parentFor(d) {
      let p = get(/databases/$(database)/documents/members/$(d.by)).data;
      return d.by is string && d.by != d.memberId && boundTo(d.by)
        && p.get('role', '') == 'parent'
        && (p.get('canMarkFor', null) == null
            ? get(/databases/$(database)/documents/members/$(d.memberId)).data.get('role', '') == 'child'
            : d.memberId in p.canMarkFor);
    }
    // "under watch": every action of this member waits for the admin's approval
    function watchedId(x) { return get(/databases/$(database)/documents/members/$(x)).data.get('watch', false) == true; }
    // this phone is signed in (with a code) as a parent
    function parentDevice() {
      let bPath = /databases/$(database)/documents/bindings/$(request.auth.uid);
      return signedIn() && exists(bPath) && boundTo(get(bPath).data.memberId)
        && get(/databases/$(database)/documents/members/$(get(bPath).data.memberId)).data.get('role', '') == 'parent';
    }
    function approvalOk(d) {
      return watchedId(d.get('by', d.memberId))
        ? d.get('approved', true) == false
        : (('by' in d && !('approved' in d))
          || (!('by' in d) && taskDoc(d.taskId).data.get('check', false) == true && d.get('approved', true) == false)
          || (!('by' in d) && taskDoc(d.taskId).data.get('check', false) != true && !('approved' in d)));
    }

    function validFixed(d) {
      return d.keys().hasOnly(['kind','taskId','title','memberId','points','count','approved','by','day','at'])
        && approvalOk(d)
        && d.kind == 'task'
        && exists(/databases/$(database)/documents/tasks/$(d.taskId))
        && taskDoc(d.taskId).data.get('timed', false) == false
        && taskDoc(d.taskId).data.get('pending', false) == false
        && memberExists(d.memberId)
        && ((!('qtyPer' in taskDoc(d.taskId).data) && !('count' in d)
              && d.points == taskDoc(d.taskId).data.points * (taskDoc(d.taskId).data.get('boss', false) == true ? 3 : 1))
          || ('qtyPer' in taskDoc(d.taskId).data && d.count is int
              && d.count >= taskDoc(d.taskId).data.qtyPer && d.count <= taskDoc(d.taskId).data.get('qtyMax', 10000)
              && d.points * taskDoc(d.taskId).data.qtyPer == (d.count - d.count % taskDoc(d.taskId).data.qtyPer) * taskDoc(d.taskId).data.points))
        && freshTime(d);
    }

    function validTimed(d) {
      let timerPath = /databases/$(database)/documents/timers/$(d.timerId);
      let timer = get(timerPath).data;
      let task = taskDoc(d.taskId).data;
      return d.keys().hasOnly(['kind','taskId','title','memberId','points','minutes','timerId','approved','by','day','at'])
        && d.kind == 'timed'
        && approvalOk(d)
        && d.timerId == d.taskId + '__' + d.memberId
        && timer.taskId == d.taskId
        && timer.memberId == d.memberId
        && task.get('timed', false) == true
        && d.minutes is int && d.minutes >= 1 && d.minutes <= task.maxMinutes
        && d.minutes * 60000 <= request.time.toMillis() - timer.startedAt.toMillis() + 60000
        && d.points == d.minutes * task.ratePerMin
        && !existsAfter(timerPath)
        && freshTime(d);
    }

    // שימוש בנקודות (מימוש פרס): כל אחד מוריד רק מהיתרה של עצמו. ביטול: רק המנהל.
    function validRedeem(d) {
      return d.keys().hasOnly(['kind','title','memberId','points','rewardId','approved','loan','day','at'])
        && d.kind == 'redeem'
        && (watchedId(d.memberId) ? d.get('approved', true) == false
            : ((!('approved' in d) || (d.approved == false && d.get('loan', false) == true))
               && (!('loan' in d) || (d.loan == true && d.get('approved', true) == false))))
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.points is int && d.points >= 1 && d.points <= 100000
        && memberExists(d.memberId)
        && (!('rewardId' in d) || (exists(/databases/$(database)/documents/rewards/$(d.rewardId))
              && get(/databases/$(database)/documents/rewards/$(d.rewardId)).data.cost == d.points))
        && freshTime(d);
    }

    function validNewTask(d) {
      return d.keys().hasOnly(['title','assignee','type','days','timed','points','ratePerMin','maxMinutes','qtyPer','qtyUnit','qtyMax','untilTime','check','rotation','reviewed','suggestedBy','createdAt'])
        && d.reviewed == false
        && validQty(d) && validUntil(d)
        && (!('check' in d) || d.check is bool)
        && (d.assignee != 'rotate' || (d.rotation is list && d.rotation.size() >= 2 && d.rotation.size() <= 20))
        && (!('rotation' in d) || d.assignee == 'rotate')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.assignee is string
        && d.type in ['once', 'repeat']
        && d.days is list && d.days.size() <= 7
        && d.createdAt is int
        && d.suggestedBy is string && boundTo(d.suggestedBy)
        && ((d.timed == true && d.ratePerMin is int && d.ratePerMin >= 1 && d.ratePerMin <= 100
              && d.maxMinutes is int && d.maxMinutes >= 1 && d.maxMinutes <= 240)
         || (d.timed == false && d.points is int && d.points >= 0 && d.points <= 1000));
    }

    // קודי כניסה: רק המנהל רואה ומשנה.
    // קוד המנהל עצמו: רק מנהל רואה ומשנה. ההגדרה הראשונה נעשית כשנכנסים עם גוגל.
    function validTaskShape(d) {
      return validQty(d) && validUntil(d)
        && (!('check' in d) || d.check is bool)
        && (d.assignee != 'rotate' || (d.rotation is list && d.rotation.size() >= 2 && d.rotation.size() <= 20))
        && (!('rotation' in d) || d.assignee == 'rotate')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.assignee is string
        && d.type in ['once', 'repeat']
        && d.days is list && d.days.size() <= 7
        && ((d.timed == true && d.ratePerMin is int && d.ratePerMin >= 1 && d.ratePerMin <= 100
              && d.maxMinutes is int && d.maxMinutes >= 1 && d.maxMinutes <= 240 && !('points' in d))
         || (d.timed == false && d.points is int && d.points >= 0 && d.points <= 1000
              && !('ratePerMin' in d) && !('maxMinutes' in d)));
    }

    match /private/{docId} {
      allow read, write: if isAdmin();
    }
    // כניסה של מכשיר למצב מנהל: מותרת רק עם הקוד הנוכחי. שינוי הקוד מוציא את כל המכשירים.
    match /adminSessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/private/admin)
        && request.resource.data.code == get(/databases/$(database)/documents/private/admin).data.code;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /pins/{memberId} {
      allow read, write: if isAdmin();
    }

    // כניסה של מכשיר בתור בן משפחה: מותרת רק עם הקוד הנכון.
    match /bindings/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['memberId','pin'])
        && request.resource.data.memberId is string
        && exists(/databases/$(database)/documents/pins/$(request.resource.data.memberId))
        && request.resource.data.pin == get(/databases/$(database)/documents/pins/$(request.resource.data.memberId)).data.pin;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // פרופיל: כולם רואים; כל אחד משנה רק את התמונה של עצמו (המנהל של כולם).
    // פרופיל: כל אחד משנה את התמונה של עצמו. תמונות המנהל רק למי שמסומן כמנהל.
    match /profiles/{memberId} {
      allow read: if signedIn();
      allow write: if (isAdmin() || boundTo(memberId))
        && request.resource.data.keys().hasOnly(['avatar'])
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && (!(request.resource.data.avatar in ['👑','🏆','💎','🐉','🦅','🔥'])
            || get(/databases/$(database)/documents/members/$(memberId)).data.get('admin', false) == true);
    }

    // בקשות הצטרפות עם חשבון גוגל: כל אחד שולח בקשה בשם עצמו, רק המנהל רואה את כולן ומאשר.
    // linkTo: "אני כבר בלוח" — בקשה לחבר את הגוגל לבן משפחה קיים. רק המנהל מחבר בפועל (members נכתב רק על ידו).
    match /joinRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['name','color','email','linkTo','at'])
        && (!('linkTo' in request.resource.data) || (request.resource.data.linkTo is string && memberExists(request.resource.data.linkTo)))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.color is string && request.resource.data.color.size() <= 9
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.at is int;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // מכשירים שמקבלים התראות. רק השרת (וגם המנהל) קורא אותם.
    match /pushTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['memberId','uid','at'])
        && request.resource.data.uid == request.auth.uid
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /members/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && validNewTask(request.resource.data));
      // עריכה: המנהל תמיד. הורה כל משימה לא נעוצה. כל אחד את המשימה שהוא הוסיף.
      allow update: if isAdmin() || (
        resource.data.get('pinned', false) == false
        && resource.data.get('pending', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','assignee','type','days','timed','points','ratePerMin','maxMinutes','qtyPer','qtyUnit','qtyMax','untilTime','check','rotation','reviewed','editedBy'])
        && request.resource.data.reviewed == false
        && validTaskShape(request.resource.data)
        && request.resource.data.editedBy is string && boundTo(request.resource.data.editedBy)
        && (get(/databases/$(database)/documents/members/$(request.resource.data.editedBy)).data.get('role', '') == 'parent'
            || resource.data.get('suggestedBy', '') == request.resource.data.editedBy));
      // משימה נעוצה: אף אחד, גם לא המנהל, לא יכול למחוק אותה עד שמבטלים נעיצה.
      allow delete: if isAdmin() && resource.data.get('pinned', false) == false;
    }
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId','memberId','text','at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time
        && request.resource.data.taskId is string
        && (request.resource.data.taskId == 'general'
            || exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)))
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if isAdmin();
    }
    // הגדרות: רק המנהל. את היעד המשפחתי יכול לשנות גם הורה (בן משפחה בדרגת "הורה" שמחובר במכשיר הזה).
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || (id == 'challenge'
        && request.resource.data.keys().hasOnly(['title','target','items','cid','start','until','prize','bonus','by'])
        && (!('cid' in request.resource.data) || (request.resource.data.cid is string && request.resource.data.cid.size() <= 60))
        && (!('items' in request.resource.data) || (request.resource.data.items is list && request.resource.data.items.size() <= 30))
        && (!('bonus' in request.resource.data) || (request.resource.data.bonus is int && request.resource.data.bonus >= 0 && request.resource.data.bonus <= 1000))
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.target is int && request.resource.data.target >= 0 && request.resource.data.target <= 100000
        && request.resource.data.start is string && request.resource.data.start.size() == 10
        && request.resource.data.until is string && request.resource.data.until.size() == 10
        && request.resource.data.prize is string && request.resource.data.prize.size() <= 40
        && request.resource.data.by is string && boundTo(request.resource.data.by)
        && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent') || (id == 'goal'
        && request.resource.data.keys().hasOnly(['target','prize','by'])
        && request.resource.data.target is int && request.resource.data.target >= 0 && request.resource.data.target <= 1000000
        && request.resource.data.prize is string && request.resource.data.prize.size() <= 40
        && request.resource.data.by is string
        && boundTo(request.resource.data.by)
        && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent');
    }
    match /timers/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['taskId','memberId','startedAt','by'])
        && id == request.resource.data.taskId + '__' + request.resource.data.memberId
        && request.resource.data.startedAt == request.time
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
        && taskDoc(request.resource.data.taskId).data.get('timed', false) == true
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || (!('by' in request.resource.data) && boundTo(request.resource.data.memberId)) || parentFor(request.resource.data));
      allow delete: if isAdmin() || boundTo(resource.data.memberId) || parentDevice();
    }
    // החלפות נקודות: כולם רואים. המנהל והורים מוסיפים ועורכים (הסרה = archived).
    match /rewards/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['title','cost','emoji','createdAt','archived','by'])
        && request.resource.data.by is string && boundTo(request.resource.data.by)
        && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent'
        && request.resource.data.cost is int && request.resource.data.cost >= 1 && request.resource.data.cost <= 100000
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 40
        && (!('emoji' in request.resource.data) || (request.resource.data.emoji is string && request.resource.data.emoji.size() <= 8))
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool);
    }

    // תלונות: כולם רואים. כל אחד מתלונן בשמו. מנהל והורים מטפלים (לא בתלונה של עצמם).
    match /complaints/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['text','cat','by','about','status','agree','at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.cat in ['fun','app','house','person','other']
        && request.resource.data.status == 'open'
        && request.resource.data.agree is list && request.resource.data.agree.size() == 0
        && request.resource.data.about is string
        && request.resource.data.at is int
        && request.resource.data.by is string && memberExists(request.resource.data.by)
        && (isAdmin() || boundTo(request.resource.data.by));
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agree'])
            && request.resource.data.agree is list && request.resource.data.agree.size() <= 30 && signedIn())
        || (resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reply','pts','target','handledAt','handledBy'])
            && request.resource.data.status in ['done','rejected']
            && request.resource.data.handledBy is string && request.resource.data.handledBy != resource.data.by
            && boundTo(request.resource.data.handledBy)
            && get(/databases/$(database)/documents/members/$(request.resource.data.handledBy)).data.get('role', '') == 'parent');
      allow delete: if isAdmin() || (resource.data.status == 'open' && boundTo(resource.data.by));
    }

    // הקפצות: המנהל שולח לכל אחד; את האתגר מקפיץ גם מי שהמנהל הרשה (עם הגבלת זמן אם סומן).
    match /nudges/{id} {
      allow read, create, update, delete: if isAdmin();
      allow get: if id == 'challenge' && signedIn();
      allow create, update: if id == 'challenge'
        && request.resource.data.keys().hasOnly(['by','at'])
        && request.resource.data.at is int && math.abs(request.resource.data.at - request.time.toMillis()) < 600000
        && request.resource.data.by is string && boundTo(request.resource.data.by)
        && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('canNudge', false) == true
        && (get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('nudgeLimited', true) == false
            || !exists(/databases/$(database)/documents/nudges/challenge)
            || request.time.toMillis() - get(/databases/$(database)/documents/nudges/challenge).data.at
               >= get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('nudgeEveryMin',
                    exists(/databases/$(database)/documents/settings/perms) ? get(/databases/$(database)/documents/settings/perms).data.get('nudgeEveryMin', 60) : 60) * 60000);
    }

    // הערות למפתח: כל אחד שולח בשמו, רק המנהל קורא ומטפל.
    match /devNotes/{id} {
      allow update: if isAdmin();
      // the writer sees their own notes, and deletes them once handled ("טופל") and seen
      allow read: if isAdmin() || (signedIn() && boundTo(resource.data.by));
      allow delete: if isAdmin() || (resource.data.status == 'done' && boundTo(resource.data.by));
      allow create: if request.resource.data.keys().hasOnly(['text','kind','by','status','at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 800
        && request.resource.data.kind in ['bug','idea','ux','other']
        && request.resource.data.status == 'new'
        && request.resource.data.at is int
        && memberExists(request.resource.data.by)
        && (isAdmin() || boundTo(request.resource.data.by));
    }

    // תגובות על תלונות: כל אחד מגיב בשמו.
    match /cpComments/{id} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['cpId','memberId','text','at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.at is int
        && exists(/databases/$(database)/documents/complaints/$(request.resource.data.cpId))
        && memberExists(request.resource.data.memberId)
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if isAdmin() || boundTo(resource.data.memberId);
    }

    // משימות האתגר (נפרדות מהמשימות הרגילות): כל משימה מסומנת פעם אחת, בשם מי שעשה אותה (או הורה בשם ילד).
    // key חייב להיות של האתגר הנוכחי. ביטול: מי שסימן, הורה, או המנהל.
    match /challengeItems/{itemId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['key','itemId','memberId','by','at'])
        && request.resource.data.itemId == itemId
        && request.resource.data.at is int
        && memberExists(request.resource.data.memberId)
        && request.resource.data.key == get(/databases/$(database)/documents/settings/challenge).data.get('cid',
             get(/databases/$(database)/documents/settings/challenge).data.start + '|' + get(/databases/$(database)/documents/settings/challenge).data.title)
        && ((!('by' in request.resource.data) && boundTo(request.resource.data.memberId))
          || (request.resource.data.by is string && boundTo(request.resource.data.by)
              && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent')));
      allow delete: if isAdmin() || boundTo(resource.data.memberId) || parentDevice();
    }

    // משתתפים באתגר: כל אחד מסמן את עצמו, הורה או מנהל יכולים לסמן כל אחד. ביטול = key ריק.
    match /challengeJoins/{memberId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['key','memberId','by','at'])
        && request.resource.data.memberId == memberId
        && request.resource.data.key is string && request.resource.data.key.size() <= 80
        && request.resource.data.at is int
        && (boundTo(memberId)
          || (request.resource.data.by is string && boundTo(request.resource.data.by)
              && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent')));
    }

    // תמונת הוכחה: קטנה, נשמרת רק עד שהמשימה נבדקת.
    match /photos/{logId} {
      allow read: if signedIn();
      allow create, update: if request.resource.data.keys().hasOnly(['data','memberId','at'])
        && request.resource.data.data is string && request.resource.data.data.size() < 600000
        && request.resource.data.at is int
        && exists(/databases/$(database)/documents/logs/$(logId))
        && get(/databases/$(database)/documents/logs/$(logId)).data.memberId == request.resource.data.memberId
        && get(/databases/$(database)/documents/logs/$(logId)).data.get('approved', true) == false
        && (isAdmin() || boundTo(request.resource.data.memberId));
      allow delete: if isAdmin() || (signedIn() && (
        !exists(/databases/$(database)/documents/logs/$(logId))
        || get(/databases/$(database)/documents/logs/$(logId)).data.get('approved', true) != false
        || boundTo(resource.data.memberId)));
    }

    match /logs/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (request.resource.data.kind == 'redeem' && validRedeem(request.resource.data) && boundTo(request.resource.data.memberId))
        || (request.resource.data.kind == 'task' && validFixed(request.resource.data) && !('by' in request.resource.data) && boundTo(request.resource.data.memberId))
        || (request.resource.data.kind == 'task' && validFixed(request.resource.data) && parentFor(request.resource.data))
        || (request.resource.data.kind == 'timed' && validTimed(request.resource.data) && !('by' in request.resource.data) && boundTo(request.resource.data.memberId))
        || (request.resource.data.kind == 'timed' && validTimed(request.resource.data) && parentFor(request.resource.data))
        || (request.resource.data.kind == 'bonus'
            && request.resource.data.keys().hasOnly(['kind','title','memberId','points','by','approved','day','at'])
            && (watchedId(request.resource.data.by) ? request.resource.data.get('approved', true) == false : !('approved' in request.resource.data))
            && get(/databases/$(database)/documents/settings/perms).data.get('parentPoints', false) == true
            && request.resource.data.points is int && request.resource.data.points != 0
            && request.resource.data.points >= -100 && request.resource.data.points <= 100
            && request.resource.data.title is string && request.resource.data.title.size() <= 80
            && memberExists(request.resource.data.memberId)
            && request.resource.data.by is string && boundTo(request.resource.data.by)
            && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent'
            && freshTime(request.resource.data))
        || (request.resource.data.kind == 'bonus'
            && request.resource.data.keys().hasOnly(['kind','title','memberId','points','complaintId','by','day','at'])
            && request.resource.data.points is int && request.resource.data.points != 0
            && request.resource.data.points >= -100 && request.resource.data.points <= 100
            && request.resource.data.title is string && request.resource.data.title.size() <= 80
            && memberExists(request.resource.data.memberId)
            && exists(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId))
            && get(/databases/$(database)/documents/complaints/$(request.resource.data.complaintId)).data.status == 'open'
            && request.resource.data.by is string && request.resource.data.by != request.resource.data.memberId
            && boundTo(request.resource.data.by)
            && get(/databases/$(database)/documents/members/$(request.resource.data.by)).data.get('role', '') == 'parent'
            && freshTime(request.resource.data));
      allow delete: if isAdmin() || (
        resource.data.kind in ['task', 'timed']
        && request.time.toMillis() - resource.data.at < 43200000
        && (boundTo(resource.data.memberId) || parentDevice())
      );
      // אישור או דחייה: המנהל, או הורה (לא על משימה של עצמו) שמשנה רק את שדה האישור.
      allow update: if isAdmin() || (
        resource.data.get('approved', true) == false
        && resource.data.kind != 'bonus'
        && !watchedId(resource.data.get('by', resource.data.memberId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved','approvedBy'])
        && request.resource.data.approved in [true, 'rejected']
        && request.resource.data.approvedBy is string
        && request.resource.data.approvedBy != resource.data.memberId
        && boundTo(request.resource.data.approvedBy)
        && get(/databases/$(database)/documents/members/$(request.resource.data.approvedBy)).data.get('role', '') == 'parent');
    }
  }
}
